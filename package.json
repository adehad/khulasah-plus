{
  "name": "khulasah-plus",
  "version": "0.0.1",
  "packageManager": "bun@1.2.23",
  "engines": {
    "node": ">=24"
  },
  "description": "Khulasah Plus — PWA for Islamic recitations, adhkar, and daily practices.",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev",
    "build:search": "bun scripts/build-search-index.ts",
    "check:nav": "bun scripts/check-nav.ts",
    "build": "bun run build:search && astro build",
    "build:prod": "bun run build:search && astro build && bun scripts/google-site-verification.ts",
    "start": "bun run dev",
    "lint": "biome check",
    "format": "biome check --write",
    "generate-pwa-assets": "pwa-assets-generator",
    "preview": "astro preview",
    "test:unit": "bun test",
    "test:visual": "playwright test --project=webkit --project=chromium",
    "test:e2e": "playwright test --project=functional",
    "test:visual:report": "playwright show-report",
    "test:pwa": "bun run build && playwright test -c playwright.pwa.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@mediabunny/mp3-encoder": "^1.27.2",
    "@shoelace-style/shoelace": "^2.20.1",
    "astro": "^6.0.4",
    "flexsearch": "^0.8.212",
    "hls.js": "^1.6.15",
    "idb": "^8.0.3",
    "lit": "^3.3.1",
    "mediabunny": "^1.27.2",
    "workbox-build": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.3.0",
    "@vite-pwa/assets-generator": "^1.0.1",
    "@vite-pwa/astro": "^1.2.0",
    "typescript": "^5.8.3"
  }
}
