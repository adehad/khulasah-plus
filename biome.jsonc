{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "scripts/**",
      "public/**",
      "tests/**",
      "*.config.ts",
      "astro.config.mjs",
      "biome.jsonc",
      "tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  // biome cannot analyze Astro template usage — imports/variables used in the
  // HTML template section (below ---) appear "unused" to biome's static analysis
  "overrides": [
    // Test rules are scoped by path because the "test" domain only auto-enables
    // for jest/vitest/mocha/ava, not bun:test or Playwright. Focused tests are an
    // error because Playwright's forbidOnly only guards CI; skips only warn since
    // a conditional test.skip() is legitimate. Non-null assertions are allowed
    // because a missing element should crash the test and fail it.
    {
      "includes": ["tests/**"],
      "linter": {
        "domains": { "test": "recommended" },
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": {
            "noFocusedTests": "error",
            "noSkippedTests": "warn"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
