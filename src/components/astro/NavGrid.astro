---
import { hasPage } from "@/config/page-config";
import type { NavModel } from "@/models/nav";
import { resolveBasePath } from "@/utils/paths";

interface Props {
  item: NavModel;
}

const { item } = Astro.props;
---

{
  // links to pages that do not exist yet (allowed in check-nav) show as disabled tiles
  hasPage(item.href) ? (
    <a class="nav-button" href={resolveBasePath(`/${item.href}`)}>
      {item.title}
    </a>
  ) : (
    <span class="nav-button disabled" aria-disabled="true">
      {item.title}
    </span>
  )
}

<style>
  .nav-button {
    padding: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color: var(--sl-color-primary-100);
    color: var(--sl-color-neutral-950);
    text-decoration: none;
    border-radius: 4px;
    margin: 8px;
    transition: background-color 0.2s;
  }

  a.nav-button:hover {
    background-color: var(--sl-color-primary-200);
  }

  .nav-button.disabled {
    background-color: var(--sl-color-neutral-100);
    color: var(--sl-color-neutral-500);
    cursor: default;
  }
</style>
