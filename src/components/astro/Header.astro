---
import { pageConfigs } from "@/config/page-config";
import { resolveBasePath } from "@/utils/paths";
import InlineIcon from "./InlineIcon.astro";

interface Props {
  pagePath: string;
}

const { pagePath } = Astro.props;

// Build a lookup map: path → title
const pathTitleMap = new Map(pageConfigs.map((c) => [c.path, c.title]));

interface Breadcrumb {
  text: string;
  href: string;
}

function buildBreadcrumbs(currentPath: string): Breadcrumb[] {
  const homeTitle = pathTitleMap.get("") ?? "Home";
  const crumbs: Breadcrumb[] = [
    { text: homeTitle, href: resolveBasePath("/") },
  ];

  if (!currentPath) return crumbs;

  const segments = currentPath.split("/").filter(Boolean);
  let accumulated = "";

  for (const segment of segments) {
    accumulated += (accumulated ? "/" : "") + segment;
    const title = pathTitleMap.get(accumulated);
    if (title) {
      crumbs.push({ text: title, href: resolveBasePath(`/${accumulated}/`) });
    }
  }

  return crumbs;
}

const breadcrumbs = buildBreadcrumbs(pagePath);
const isHome = !pagePath;
const homeCrumb = breadcrumbs[0];
const currentCrumb =
  breadcrumbs.length > 1 ? breadcrumbs[breadcrumbs.length - 1] : null;
const intermediateCrumbs = breadcrumbs.slice(1, breadcrumbs.length - 1);
const onFavouritesPage = pagePath === "favourites";
---

<header>
  <nav aria-label="Breadcrumb" class="breadcrumb">
    <a href={isHome ? "#" : homeCrumb.href} class="breadcrumb-link">
      <InlineIcon name="house" size="1.2rem" label="Home" />
    </a>

    {intermediateCrumbs.length > 0 && (
      <>
        <span class="separator" aria-hidden="true">/</span>
        <sl-dropdown>
          <sl-button slot="trigger" size="small" caret>{intermediateCrumbs.length}</sl-button>
          <sl-menu>
            {intermediateCrumbs.map(crumb => (
              <a href={crumb.href}><sl-menu-item>{crumb.text}</sl-menu-item></a>
            ))}
          </sl-menu>
        </sl-dropdown>
      </>
    )}

    {currentCrumb && (
      <>
        <span class="separator" aria-hidden="true">/</span>
        <span class="breadcrumb-current">
          {currentCrumb.text}
          {!onFavouritesPage && (
            <kp-favourite-star class="page-star" href={pagePath} label={currentCrumb.text}></kp-favourite-star>
          )}
        </span>
        <sl-dropdown id="toc-dropdown" style="display: none;">
          <button slot="trigger" class="toc-trigger">
            <InlineIcon name="chevron-double-down" size="1rem" label="Table of contents" />
          </button>
          <sl-menu id="toc-menu"></sl-menu>
        </sl-dropdown>
      </>
    )}
  </nav>

  <div class="header-actions">
    <a
      href={resolveBasePath("/favourites/")}
      class="header-btn"
      aria-label="Favourites"
      aria-current={onFavouritesPage ? "page" : undefined}
    >
      <InlineIcon name={onFavouritesPage ? "star-fill" : "star"} size="1.5rem" />
    </a>
    <kp-search-button></kp-search-button>
    <settings-menu></settings-menu>
    <theme-switcher></theme-switcher>
  </div>

  <kp-audio-player></kp-audio-player>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    /* Centred so actions that wrap onto their own row stay centred; the breadcrumb's auto margin keeps the
       single-row layout of breadcrumb left, actions right */
    justify-content: center;
    align-items: center;
    background: var(--sl-color-neutral-0);
    padding: 12px;
    padding-top: calc(4px + env(titlebar-area-y, 0));
    padding-bottom: 0px;
    min-height: env(titlebar-area-height, 30px);
    -webkit-app-region: drag;
    z-index: 100;
    position: sticky;
    top: 0;
    flex-shrink: 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    margin-right: auto;
    gap: 0.5rem;
    font-size: var(--sl-font-size-small);
    -webkit-app-region: no-drag;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    color: var(--sl-color-neutral-600);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--sl-color-primary-600);
  }

  .separator {
    color: var(--sl-color-neutral-500);
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--sl-color-neutral-950);
    font-weight: var(--sl-font-weight-semibold);
  }

  /* Inline inside the title so a wrapped title keeps its star right after the last word */
  .page-star {
    --kp-favourite-star-size: 1rem;
    font-weight: normal;
    color: var(--sl-color-neutral-600);
  }

  .toc-trigger {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    color: var(--sl-color-neutral-600);
    transform: translateY(0.15rem);
  }

  .toc-trigger:hover {
    color: var(--sl-color-primary-600);
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    -webkit-app-region: no-drag;
  }

  /* Mirrors the shared circle-btn look of the neighbouring Lit header buttons */
  .header-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid transparent;
    color: var(--sl-color-primary-500);
    transition:
      background-color 0.2s ease-in-out,
      border-color 0.2s ease-in-out;
  }

  .header-btn:hover {
    background-color: var(--sl-color-primary-100);
    border-color: var(--sl-color-primary-300);
  }

  kp-audio-player {
    flex-shrink: 0;
  }

  kp-audio-player:not([collapsed]) {
    width: 100%;
    order: 1;
  }

  /* Style links inside dropdown menu items */
  a {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 420px) {
    header {
      justify-content: center;
      gap: 0.5rem;
    }

    .breadcrumb {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .header-actions {
      width: 100dvw;
      justify-content: center;
    }
  }
</style>
