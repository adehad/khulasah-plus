---
import { SURAH_NAMES } from "@/data/shared/surah-names";
import { type QasidaEntryModel, QuranEntryModel } from "@/models/recitation";
import VerseEnd from "./VerseEnd.astro";

interface Props {
  entry: QasidaEntryModel | QuranEntryModel;
  /** count shown inline when this line is repeated on its own */
  repeatText?: string;
}

const { entry, repeatText = "" } = Astro.props;
const isQuran = entry instanceof QuranEntryModel;
const surah = isQuran ? entry.surah : undefined;
---

<div class="qasida-entry">
  <div class:list={["arabic", { quran: isQuran }]} dir="rtl" lang="ar">
    {isQuran ? (
      <>
        {/* a no-break space keeps the verse end on the line of the verse's last word */}
        {"﴿"}{entry.arabic}{" "}<VerseEnd verse={(entry as QuranEntryModel).verse} />{"﴾"}{repeatText}
      </>
    ) : (
      <>{entry.arabic}{repeatText}</>
    )}
  </div>
  <div class="translit">{entry.translit}{repeatText}</div>
  <div class="translation">{entry.translation}{repeatText}</div>
  {surah && (
    <kp-footnote type="quran">
      Surah {SURAH_NAMES.get(surah) ?? `Surah ${surah}`} ({surah}):{(entry as QuranEntryModel).verse}
    </kp-footnote>
  )}
</div>

<style>
  .qasida-entry {
    margin-bottom: 1em;
    text-align: center;
    flex: 1 1 100%;
    box-sizing: border-box;
  }

  @container (width > 600px) {
    .qasida-entry {
      flex: 0 1 48%;
    }

    .qasida-entry:only-child {
      flex-basis: 100%;
    }
  }
</style>
