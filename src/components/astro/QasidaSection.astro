---
import {
  ExpandModel,
  QasidaChapterModel,
  type QasidaModel,
  QasidaVerseModel,
} from "@/models/recitation";
import { slugify } from "@/utils/string";
import ExpandSection from "./ExpandSection.astro";
import QasidaVerse from "./QasidaVerse.astro";

interface Props {
  model: QasidaModel;
  index: number;
  pagePath: string;
}

const { model, index, pagePath } = Astro.props;
const prefix = `q${index + 1}`;
const hasAudio = !!model.audio?.url;
---

<div class="qasida-container" style="container-type: inline-size;">
  {model.title && (
    <div class="qasida-title-row">
      <h1 id={slugify(model.title)} class="qasida-title">{model.title}</h1>
      {hasAudio && (
        <sl-icon-button
          class="circle-btn audio-play-btn"
          name="play-circle"
          label="Play audio"
          data-audio-url={model.audio!.url}
          data-audio-title={model.audio!.title ?? model.title}
        ></sl-icon-button>
      )}
    </div>
  )}

  {model.instruction && <p class="instruction">{model.instruction}</p>}

  {model.entries.map((entry, i) => {
    if (entry instanceof ExpandModel) {
      const expandId = `${prefix}-expand-${i + 1}`;
      return (
        <div id={expandId}>
          <ExpandSection model={entry} index={i} pagePath={pagePath} />
        </div>
      );
    }
    if (entry instanceof QasidaChapterModel) {
      const chapterId = `${prefix}-chapter-${i + 1}`;
      return (
        <Fragment>
          <kp-sticky-button label={entry.number} elementId={chapterId} variant="chapter"></kp-sticky-button>
          <h1 id={chapterId} class="chapter-header">{entry.title}</h1>
          {entry.instruction && <p class="instruction">{entry.instruction}</p>}
          {entry.entries.map((chapterEntry, j) => {
            if (chapterEntry instanceof QasidaVerseModel) {
              return <QasidaVerse verse={chapterEntry} verseId={`${prefix}-verse-${i + 1}-${j + 1}`} label={j + 1} />;
            }
            if (chapterEntry instanceof ExpandModel) {
              return <ExpandSection model={chapterEntry} index={j} pagePath={pagePath} />;
            }
            throw new Error(`QasidaSection: unhandled chapter entry type "${chapterEntry?.constructor?.name}"`);
          })}
        </Fragment>
      );
    }
    if (entry instanceof QasidaVerseModel) {
      return <QasidaVerse verse={entry} verseId={`${prefix}-verse-${i + 1}`} label={i + 1} />;
    }
    throw new Error(`QasidaSection: unhandled entry type "${entry?.constructor?.name}"`);
  })}
</div>

<style>
  .qasida-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .qasida-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .qasida-title {
    text-align: center;
    margin: 0;
  }

  .chapter-header {
    text-align: center;
  }

  .circle-btn {
    font-size: 1.5rem;
    color: var(--sl-color-primary-500);
    transition: background-color 0.2s ease-in-out;
  }
</style>
