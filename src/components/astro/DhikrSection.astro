---
import { SURAH_NAMES } from "@/data/shared/surah-names";
import {
  DHIKR_COUNTER_THRESHOLD,
  DhikrEntryModel,
  type DhikrModel,
  QuranDhikrEntryModel,
} from "@/models/recitation";
import { repeatDisplay } from "@/utils/repeat";
import DhikrEntry from "./DhikrEntry.astro";
import QuranEntry from "./QuranEntry.astro";
import RepeatNote from "./RepeatNote.astro";

interface Props {
  model: DhikrModel;
  index: number;
  elementId?: string;
}

const { model, index, elementId: providedId } = Astro.props;

const modelRepeat = model.repeat ?? 1;
const showModelCounter = modelRepeat > DHIKR_COUNTER_THRESHOLD;
// a one-line group shows its count inline on that line; its own count wins if it has one
const groupSuffix = repeatDisplay(modelRepeat, model.entries.length).suffix;
const lineSuffix = (repeat: number) =>
  repeatDisplay(repeat, 1).suffix || groupSuffix;

const elementId = providedId ?? `${index + 1}`;
const makeKey = (suffix?: number) => {
  return suffix !== undefined ? `${elementId}-${suffix}` : elementId;
};
---

<div class="dhikr-container" id={elementId}>
  {model.instruction && <p class="instruction">{model.instruction}</p>}
  <RepeatNote count={modelRepeat} lines={model.entries.length} />
  {model.entries.map((entry, i) => {
    if (entry instanceof QuranDhikrEntryModel) {
      const surahName = SURAH_NAMES.get(entry.surah) ?? `Surah ${entry.surah}`;
      const showCounter =
        entry.repeat > DHIKR_COUNTER_THRESHOLD || entry.enableCounter === true;
      return (
        <>
          <QuranEntry
            entry={entry}
            openingBrace={true}
            closingBrace={true}
            repeatText={lineSuffix(entry.repeat)}
          />
          {showCounter && (
            <kp-dhikr-counter target={entry.repeat} storagekey={makeKey(i)} />
          )}
          <kp-footnote type="quran">
            Surah {surahName} ({entry.surah}):{entry.verse}
          </kp-footnote>
        </>
      );
    }
    return (
      <DhikrEntry
        entry={entry as DhikrEntryModel}
        storageKey={makeKey(i)}
        repeatText={lineSuffix(entry.repeat)}
      />
    );
  })}
  {showModelCounter && (
    <kp-dhikr-counter
      target={modelRepeat}
      storagekey={makeKey()}
    ></kp-dhikr-counter>
  )}
</div>

<style>

</style>
