{
  "id": "/",
  "scope": "/",
  "protocol_handlers": [
    {
      "protocol": "web+khulasahplus",
      "url": "/?url=%s"
    }
  ],
  "name": "Khulasah Plus",
  "display": "standalone",
  "start_url": "/",
  "short_name": "Khulasah+",
  "lang": "en",
  "dir": "ltr",
  "theme_color": "#f3f3f3",
  "description": "Islamic recitations, adhkar and daily practices, with Arabic, transliteration, translation and audio. Works offline.",
  "orientation": "any",
  "background_color": "#c8e8e5",
  "related_applications": [],
  "prefer_related_applications": false,
  "display_override": ["window-controls-overlay", "standalone"],
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
